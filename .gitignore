# git-ignore file
# split into default and project-specific sections

###############################################################################
# Project-Specific

# scratch folder
scratch/

# _old
**/_old


###############################################################################
# Default

*.DS_Store

# Latex Files
*.aux
*.blg
*.gz
*.out
*.fls
*.fdb_latexmk
/macro_paper.log
# Snakemake and showyourwork temporaries
**/.snakemake
**/.showyourwork*

# Showyourwork output files
/*.pdf
report.html
arxiv.tar.gz

# Figure output
src/tex/figures/*

# Miscellaneous
__pycache__
*.synctex.gz
macrolimits/
