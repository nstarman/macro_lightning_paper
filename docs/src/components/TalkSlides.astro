---
// Slides from the 2026 journal-club talk on macroscopic dark matter, opened at one slide:
// <TalkSlides slide="forming-plasma-channels">Caption.</TalkSlides>. The deck is the talk's lightning
// section, cut by the talk's scripts/explainers.py into public/talk/lightning.html (one offline file,
// no speaker notes); `slide` is a slide's id in it. Not syw-site's: syw-site upgrades leave it alone.
import { url } from '../lib/facts.js';

const { slide } = Astro.props;
const deck = url(`talk/lightning.html#/${slide}`);
---
<figure class="syw-webapp syw-talk">
  <iframe src={deck} title={`Slides from the talk: ${slide}`} loading="lazy" allowfullscreen></iframe>
  <figcaption>
    <slot />
    <div class="fig-links">
      <span>From the talk · click the slide, then step with the arrow keys</span>
      <span><a href={deck}>Open</a></span>
    </div>
  </figcaption>
</figure>

<style>
  .syw-talk iframe { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; }
</style>
